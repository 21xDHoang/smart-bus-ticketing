<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="MailKit" Version="4.18.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <!-- Font cho PDF vé điện tử (task dòng 42, US 4): Roboto Regular/Bold bản hinted của Google —
       font Lato mặc định kèm QuestPDF thiếu dấu tiếng Việt. Nhúng thẳng vào assembly thay vì
       Content: SmartBus.Tests tham chiếu assembly này nên có font mà không phải copy file, CI
       ubuntu không phụ thuộc đường dẫn. Roboto-LICENSE.txt (Apache-2.0) đi kèm để bản phát hành
       mang theo giấy phép. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\Roboto-Regular.ttf" LogicalName="SmartBus.Api.Assets.Roboto-Regular.ttf" />
    <EmbeddedResource Include="Assets\Roboto-Bold.ttf" LogicalName="SmartBus.Api.Assets.Roboto-Bold.ttf" />
    <EmbeddedResource Include="Assets\Roboto-LICENSE.txt" LogicalName="SmartBus.Api.Assets.Roboto-LICENSE.txt" />
  </ItemGroup>

</Project>
